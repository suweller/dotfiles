#!/usr/bin/env zsh
# Daily review - end of day shutdown routine

set -euo pipefail

clear
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  DAILY REVIEW - $(date '+%A, %B %d, %Y %H:%M')"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo

# Select review context
REVIEW_CONTEXT=$(printf "home\nwork\nzouk\nall" | fzf \
  --prompt="Review context: " \
  --height=7 \
  --border \
  --border-label=" Daily Review ")

if [[ "$REVIEW_CONTEXT" != "all" ]]; then
  FILTER="+$REVIEW_CONTEXT"
else
  FILTER=""
fi

echo
echo "━━━ Completed Today ━━━"
task end.after:today-1d $FILTER completed 2>/dev/null || echo "No tasks completed today"

COMPLETED_COUNT=$(task end.after:today-1d $FILTER count 2>/dev/null || echo 0)
echo
echo "You completed $COMPLETED_COUNT tasks today! 🎉"

echo
echo "━━━ Still Pending Today ━━━"
task due:today status:pending $FILTER 2>/dev/null || echo "No pending tasks for today"

PENDING_TODAY=$(task due:today status:pending $FILTER count 2>/dev/null || echo 0)

if [[ $PENDING_TODAY -gt 0 ]]; then
  echo
  echo "━━━ Handle Incomplete Tasks ━━━"
  echo "Options for incomplete tasks:"
  echo "  • Mark as done if completed"
  echo "  • Defer (due:tomorrow, due:eow)"
  echo "  • Re-prioritize"
  echo "  • Delete if no longer relevant"
  echo
  read -k 1 "?Open task manager to handle? [Y/n] "
  echo
  if [[ $REPLY =~ ^[Yy]$ ]] || [[ -z $REPLY ]]; then
    task context none >/dev/null 2>&1
    TASK_FILTER="due:today status:pending $FILTER" tw
  fi
fi

echo
echo "━━━ Blocked Tasks ━━━"
task status:waiting $FILTER 2>/dev/null | head -10 || echo "No blocked tasks"

echo
echo "━━━ Brain Dump ━━━"
echo "Capture anything on your mind before closing..."
echo "(Press Ctrl+C or leave blank when done)"
echo

while true; do
  read "?Quick capture: " CAPTURE_ITEM
  [[ -z "$CAPTURE_ITEM" ]] && break

  task-capture "$CAPTURE_ITEM"
done

# Record review completion
task add "Daily review completed" +review +daily done:$(date '+%Y-%m-%d') >/dev/null 2>&1

echo
echo "✓ Daily review complete. Rest well! 😴"
