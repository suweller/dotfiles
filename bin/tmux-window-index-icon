#!/usr/bin/env bash
# Display window index as icon, using different icon when multiple panes
# Usage: tmux-window-index-icon <idx> [pane_count] [style]
# style: fill (default) or outline

one_fill=(󰎡 󰎤 󰎧 󰎪 󰎭 󰎱 󰎳 󰎶 󰎹 󰎼 󰽽)
two_fill=(󰼎 󰼏 󰼐 󰼑 󰼒 󰼓 󰼔 󰼕 󰼖 󰼗 󰿪)
one_outline=(󰎣 󰎦 󰎩 󰎬 󰎮 󰎰 󰎵 󰎸 󰎻 󰎾 󰽾)
two_outline=(󰎢 󰎥 󰎨 󰎫 󰎲 󰎯 󰎴 󰎷 󰎺 󰎽 󰿫)

idx=${1:-0}
pane_count=${2:-1}
style=${3:-fill}

# Clamp to array bounds
if ((idx < 0)); then idx=0; fi
if ((idx >= ${#one_fill[@]})); then idx=$((${#one_fill[@]} - 1)); fi

if [[ $style == "outline" ]]; then
  if ((pane_count > 1)); then
    echo "${two_outline[$idx]}"
  else
    echo "${one_outline[$idx]}"
  fi
else
  if ((pane_count > 1)); then
    echo "${two_fill[$idx]}"
  else
    echo "${one_fill[$idx]}"
  fi
fi
